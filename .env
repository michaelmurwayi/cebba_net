# ==========================================================
# CEBBA stack — consumed by stack-compose.yml
# NOTE: `docker stack deploy` performs ${VAR} interpolation but does NOT
# honour `env_file:`. Export POSTGRES_PASSWORD and SECRET_KEY in the shell
# before deploying; everything here is a safe default.
# ==========================================================

# ---------- CEBBA website ----------
IMAGE_TAG=v1.1

# ---------- Orion images ----------
# Published to Docker Hub under the michaelmurwayi namespace.
ORION_API_IMAGE=michaelmurwayi/orion:latest
ORION_DASHBOARD_IMAGE=michaelmurwayi/orion-dashboard:latest
ORION_POSTGRES_IMAGE=michaelmurwayi/orion-postgres:latest

# ---------- Container ports ----------
# Defaults come from the source Dockerfiles:
#   ~/Code/orion/api  -> python:3.13-slim, EXPOSE 8000
#   ~/Code/nexus     -> nginxinc/nginx-unprivileged, EXPOSE 8080
# If a build serves on plain 80 instead (e.g. a stock-nginx dashboard image),
# change it here — Traefik's port label and the healthcheck both follow.
ORION_API_PORT=8000
ORION_DASHBOARD_PORT=8080
ORION_POSTGRES_PORT=5432

# ---------- Orion hostnames ----------
# Must match the DNS records pointing at the Traefik entrypoint.
ORION_API_HOST=api.orion.cebba.ke
ORION_DASHBOARD_HOST=orion.cebba.ke

# ---------- Postgres ----------
# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_DB=orion
POSTGRES_TEST_DB=orion
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/orion
# URL-embedded into DATABASE_URL, so restrict to A-Za-z0-9-._~ characters.
POSTGRES_PASSWORD=postgres

# ---------- API ----------
SECRET_KEY=
# JSON list of allowed origins — the DASHBOARD origin, not the API origin.
CORS_ORIGINS=["https://orion.cebba.ke"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30